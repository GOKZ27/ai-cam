# Konfigurasi layanan Python AI Cam.
# SALIN file ini menjadi `.env` di folder yang sama, lalu isi nilainya.
# File `.env` sudah diabaikan oleh git dan tidak boleh berisi nilai asli di repo.

# Penyedia deskripsi vision: auto | gemini | ollama
# auto  = pakai Gemini bila siap, jika tidak pakai Ollama
# gemini = utamakan Gemini (cadangan ke Ollama bila AI_VISION_FALLBACK aktif)
# ollama = selalu pakai Ollama lokal
AI_VISION_PROVIDER=auto

# Izinkan cadangan otomatis ke Ollama saat Gemini gagal (1/0)
AI_VISION_FALLBACK=1

# Kunci API Google Gen AI. Biarkan kosong bila belum punya.
GEMINI_API_KEY=

# Nama model Gemini yang mendukung gambar.
# JANGAN menebak: jalankan `python list_gemini_models.py` untuk melihat daftar
# model yang tersedia untuk kunci Anda, lalu isi salah satu di bawah ini.
# Contoh dari daftar kunci saat ini:
# GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL=

# Model Gemini cadangan bila model utama kena kuota/error (dipisah koma).
# Contoh: GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=

# Batas waktu permintaan ke Gemini (detik) dan panjang balasan maksimum.
GEMINI_TIMEOUT=30
GEMINI_MAX_OUTPUT_TOKENS=256

# Minta balasan JSON terstruktur dari Gemini (1/0)
GEMINI_JSON_MODE=1

# Kendali "thinking" Gemini (menyeimbangkan latensi dan akurasi).
# Kosong = pakai bawaan model. Untuk realtime bisa coba level LOW atau budget 0.
# GEMINI_THINKING_LEVEL=LOW
# GEMINI_THINKING_BUDGET=0

# Percobaan ulang saat Gemini error sementara (5xx/kuota/timeout) sebelum
# beralih ke Ollama. Delay bertambah tiap percobaan (delay * percobaan).
GEMINI_RETRIES=2
GEMINI_RETRY_DELAY=1.5

# --- Deteksi lokal ---
# Model lebih besar = lebih akurat. n< s< m< l (makin lambat di CPU).
# Ukur dulu di mesin Anda: `.venv\Scripts\python.exe bench_yolo.py [foto.jpg]`.
#   yolo11n.pt @ 640 = paling cepat (~0,25 dtk, CPU) -> paling realtime.
#   yolo11s.pt @ 640 = seimbang akurat + realtime (~0,5 dtk) -> disarankan.
#   yolo11n.pt @ 960 = objek kecil/jauh lebih terbaca (~0,45 dtk).
#   yolo11m.pt       = akurat tetapi >1,3 dtk, kurang realtime.
YOLO_MODEL=yolo11s.pt
# Ukuran inferensi (px, kelipatan 32). 640 cepat; 960 lebih akurat untuk objek kecil.
YOLO_IMGSZ=640
# Ambang keyakinan deteksi. Naikkan untuk mengurangi salah deteksi.
YOLO_CONF=0.4
# Ambang IoU NMS (0..1). Turunkan (mis. 0.5) untuk menekan kotak ganda/bertumpuk.
YOLO_IOU=0.6
# Batas jumlah kotak per gambar.
YOLO_MAX_DET=50
# Muat model saat startup agar request pertama tidak lambat (1/0).
YOLO_PRELOAD=1
# Thread CPU torch; 0 = pakai bawaan torch (biasanya sudah optimal).
# YOLO_THREADS=0

# --- Model custom (hasil fitur "Ajar Objek" + training) ---
# Model COCO utama TETAP dipakai; bila diisi, /detect menjalankan keduanya lalu
# menggabungkan kotaknya sehingga 80 kelas lama + objek ajaran Anda terdeteksi.
# Path relatif dihitung dari folder python-service/.
# YOLO_CUSTOM_MODEL=custom.pt
# Ambang keyakinan khusus model custom (bawaan mengikuti YOLO_CONF).
# YOLO_CUSTOM_CONF=0.4
# Folder penyimpanan dataset anotasi dari kamera (bawaan: python-service/datasets).
# DATASET_DIR=datasets

# --- Ollama (cadangan / mode lokal) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_TIMEOUT=120
OLLAMA_SEED=42

# --- Tuning gambar untuk model vision ---
VISION_MAX_SIDE=1024
VISION_JPEG_QUALITY=85
LOW_LIGHT_THRESHOLD=60
YOLO_HINT_CONF=0.4

# LEVEL log: DEBUG | INFO | WARNING
LOG_LEVEL=INFO
